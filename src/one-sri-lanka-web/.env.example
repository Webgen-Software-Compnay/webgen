# Review Nation Web Application Environment Configuration

# Application Settings
APP_NAME="Review Nation Web"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# API Configuration - URL to the Review Nation API service (one-sri-lanka-api)
API_BASE_URL=http://127.0.0.1:8080/api

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=review_nation_web
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-username
MAIL_PASSWORD=your-password
MAIL_FROM_ADDRESS=noreply@reviewnation.lk
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Complaint System Configuration
COMPLAINT_MAX_FILE_SIZE=5120
COMPLAINT_ALLOWED_EXTENSIONS="jpg,jpeg,png,pdf,doc,docx"
COMPLAINT_AUTO_ASSIGNMENT=true
COMPLAINT_NOTIFICATION_EMAIL=admin@reviewnation.lk

# Rate Limiting Configuration
RATE_LIMIT_COMPLAINTS_PER_HOUR=5
RATE_LIMIT_TRACKING_REQUESTS_PER_MINUTE=10

# Feature Flags
FEATURE_FEEDBACK_SYSTEM=true
FEATURE_FILE_UPLOADS=true
FEATURE_SMS_NOTIFICATIONS=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_PUBLIC_STATISTICS=true

# One Sri Lanka API Configuration
ONE_SRI_LANKA_API_BASE_URL=http://127.0.0.1:8080/api
ONE_SRI_LANKA_API_TIMEOUT=30
ONE_SRI_LANKA_API_RETRY_ATTEMPTS=3
ONE_SRI_LANKA_API_RETRY_DELAY=1000
